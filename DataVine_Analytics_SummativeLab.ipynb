   "source": [
    "# Summative Lab: DataVine Analytics\n",
    "\n",
    "This notebook solves three client projects using k-NN Classification (Wine Dataset), Recommendation Systems (Chickwts Dataset), and Clustering (K-Means & GMM, USArrests Dataset).\n",
    "\n",
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1be8693a",
   "metadata": {},
   "source": [
    "## Step 1: Load and Prepare Datasets\n",
    "\n",
    "- Load Wine, Chickwts, USArrests datasets\n",
    "- Inspect for missing values and inconsistencies\n",
    "- Standardize numerical features\n",
    "- Summarize structure"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5c26e5e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.model_selection import GridSearchCV, train_test_split\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.metrics import classification_report, accuracy_score\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.mixture import GaussianMixture\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Load datasets\n",
    "wine = pd.read_csv('wine_data.csv')\n",
    "chickwts = pd.read_csv('chickwts_data.csv')\n",
    "arrests = pd.read_csv('arrests_data.csv')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e450def8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Inspect datasets for missing values, info, etc.\n",
    "print('--- Wine Data Info ---')\n",
    "wine.info()\n",
    "print('\n",
    "Missing values:', wine.isnull().sum().sum())\n",
    "\n",
    "print('\n",
    "--- Chickwts Data Info ---')\n",
    "chickwts.info()\n",
    "print('\n",
    "Missing values:', chickwts.isnull().sum().sum())\n",
    "\n",
    "print('\n",
    "--- USArrests Data Info ---')\n",
    "arrests.info()\n",
    "print('\n",
    "Missing values:', arrests.isnull().sum().sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b3245cfa",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Standardize numerical columns (remove non-numeric + index columns as needed)\n",
    "wine_features = wine.select_dtypes(include=[np.number]).drop('target', axis=1)\n",
    "wine_scaled = pd.DataFrame(StandardScaler().fit_transform(wine_features), columns=wine_features.columns)\n",
    "\n",
    "chickwts_scaled = chickwts.copy()\n",
    "if 'weight' in chickwts_scaled:\n",
    "    chickwts_scaled['weight'] = StandardScaler().fit_transform(chickwts_scaled[['weight']])\n",
    "\n",
    "arrests_scaled = pd.DataFrame(StandardScaler().fit_transform(arrests.select_dtypes(include=[np.number])),\n",
    "                             columns=arrests.select_dtypes(include=[np.number]).columns)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f8e47b35",
   "metadata": {},
   "source": [
    "## Step 2: k-Nearest Neighbors (k-NN) Classification on the Wine Dataset\n",
    "- Convert categorical targets, if present\n",
    "- Use PCA to retain 95% variance\n",
    "- Hyperparameter tune k and distance metric (GridSearchCV)\n",
    "- Train k-NN with best parameters\n",
    "- Report classification results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6917fafe",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare target and features\n",
    "y = wine['target']\n",
    "X = wine_scaled\n",
    "# Optional: encode target if not numeric\n",
    "if y.dtype == object:\n",
    "    le = LabelEncoder()\n",
    "    y = le.fit_transform(y)\n",
    "\n",
    "# PCA retaining 95% variance\n",
    "pca = PCA(n_components=0.95)\n",
    "X_pca = pca.fit_transform(X)\n",
    "print(f'PCA retained shape: {X_pca.shape}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f0eabd94",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Split data\n",
    "X_train, X_test, y_train, y_test = train_test_split(X_pca, y, test_size=0.2, random_state=42)\n",
    "# Grid search for k and metric\n",
    "param_grid = {'n_neighbors': list(range(3, 16)), 'metric': ['euclidean', 'manhattan']}\n",
    "knn = KNeighborsClassifier()\n",
    "grid = GridSearchCV(knn, param_grid, cv=5)\n",
    "grid.fit(X_train, y_train)\n",
    "print('Best params:', grid.best_params_)\n",
    "# Fit with best params\n",
    "best_knn = grid.best_estimator_\n",
    "# Prediction and evaluation\n",
    "y_pred = best_knn.predict(X_test)\n",
    "print(classification_report(y_test, y_pred))\n",
    "print('Accuracy:', accuracy_score(y_test, y_pred))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cd1a06bc",
   "metadata": {},
   "source": [
    "## Step 3: Build a Recommendation System Using the Chickwts Dataset\n",
    "- Standardize `weight`\n",
    "- Apply PCA (one component)\n",
    "- Compute cosine similarity between feeds\n",
    "- Recommend top N most similar feeds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8a7f0ee8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# If not already done, weight is standardized\n",
    "pca_feed = PCA(n_components=1)\n",
    "chickwts_pca = pca_feed.fit_transform(chickwts_scaled[[col for col in chickwts_scaled.columns if col != 'feedname']])\n",
    "# Create matrix of mean embeddings per feed\n",
    "feed_grouped = chickwts_scaled.copy()\n",
    "feed_grouped['pca'] = chickwts_pca\n",
    "feed_means = feed_grouped.groupby('feedname')['pca'].mean().values.reshape(-1, 1)\n",
    "cos_sim = cosine_similarity(feed_means)\n",
    "feed_names = feed_grouped['feedname'].unique()\n",
    "sim_matrix = pd.DataFrame(cos_sim, index=feed_names, columns=feed_names)\n",
    "print('Cosine Similarity Matrix (Feeds):\n",
    "', sim_matrix)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4b235bf7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Recommend top 3 most similar feeds for each type (by cosine similarity)\n",
    "recommendations = {}\n",
    "for feed in feed_names:\n",
    "    top_similar = sim_matrix[feed].sort_values(ascending=False)[1:4]\n",
    "    recommendations[feed] = list(top_similar.index)\n",
    "print('Feed Recommendations:')\n",
    "for k, v in recommendations.items():\n",
    "    print(f\"{k}: {', '.join(v)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2e99b8e9",
   "metadata": {},
   "source": [
    "## Step 4: Clustering (K-Means & GMM) on the USArrests Dataset\n",
    "- Standardize all numeric features\n",
    "- Select top 3 relevant features\n",
    "- PCA to 2D for visualization\n",
    "- Find optimal k (elbow for K-Means, BIC for GMM)\n",
    "- Assign clusters (K-Means: hard, GMM: soft)\n",
    "- Visualize results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9787f017",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature selection: top 3 by variance\n",
    "features_var = arrests_scaled.var().sort_values(ascending=False).index[:3]\n",
    "arrests_selected = arrests_scaled[features_var]\n",
    "# PCA to 2 components\n",
    "pca_ar = PCA(n_components=2)\n",
    "arrests_pca = pca_ar.fit_transform(arrests_selected)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "515ce482",
   "metadata": {},
   "outputs": [],
   "source": [
    "# K-Means: elbow method\n",
    "inertia = []\n",
    "for k in range(1, 10):\n",
    "    km = KMeans(n_clusters=k, random_state=42)\n",
    "    km.fit(arrests_pca)\n",
    "    inertia.append(km.inertia_)\n",
    "plt.plot(range(1, 10), inertia, marker='o')\n",
    "plt.title('Elbow Method (K-Means)')\n",
    "plt.xlabel('k')\n",
    "plt.ylabel('Inertia')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f3416306",
   "metadata": {},
   "outputs": [],
   "source": [
    "# GMM: BIC evaluation\n",
    "bics = []\n",
    "for k in range(1, 10):\n",
    "    gmm = GaussianMixture(n_components=k, random_state=42)\n",
    "    gmm.fit(arrests_pca)\n",
    "    bics.append(gmm.bic(arrests_pca))\n",
    "plt.plot(range(1, 10), bics, marker='o', color='orange')\n",
    "plt.title('BIC vs K (GMM)')\n",
    "plt.xlabel('k')\n",
    "plt.ylabel('BIC')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "408712cc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Choose k (example: k=3)\n",
    "optimal_k = 3  # Update after inspecting elbow and BIC\n",
    "# K-Means fit and assignment\n",
    "km = KMeans(n_clusters=optimal_k, random_state=42)\n",
    "arrests_kmeans = km.fit_predict(arrests_pca)\n",
    "# GMM fit and assignment\n",
    "gmm = GaussianMixture(n_components=optimal_k, random_state=42)\n",
    "arrests_gmm = gmm.fit_predict(arrests_pca)\n",
    "arrests_gmm_probs = gmm.predict_proba(arrests_pca)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7577ad5f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot clusters: K-Means vs GMM\n",
    "fig, axs = plt.subplots(1, 2, figsize=(12, 5))\n",
    "axs[0].scatter(arrests_pca[:, 0], arrests_pca[:, 1], c=arrests_kmeans, cmap='viridis')\n",
    "axs[0].set_title('K-Means Clustering')\n",
    "axs[1].scatter(arrests_pca[:, 0], arrests_pca[:, 1], c=arrests_gmm, cmap='plasma')\n",
    "axs[1].set_title('GMM Clustering')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ff591781",
